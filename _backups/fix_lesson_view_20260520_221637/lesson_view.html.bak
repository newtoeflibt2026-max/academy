<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>الدرس</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Segoe UI','Tahoma',sans-serif;background:#f8fafc;color:#0f172a;line-height:1.7}
  .container{max-width:900px;margin:0 auto;padding:24px}
  .header{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:32px 24px;border-radius:20px;margin-bottom:24px;box-shadow:0 10px 30px rgba(99,102,241,.2)}
  .header .code{display:inline-block;background:rgba(255,255,255,.2);padding:4px 12px;border-radius:8px;font-size:13px;margin-bottom:8px}
  .header h1{font-size:24px;font-weight:700;margin-bottom:8px}
  .header .focus{opacity:.9;font-size:15px}
  .header .meta{display:flex;gap:16px;margin-top:16px;font-size:14px}
  .header .meta span{background:rgba(255,255,255,.15);padding:6px 14px;border-radius:20px}
  .section{background:#fff;padding:24px;border-radius:16px;margin-bottom:16px;box-shadow:0 2px 8px rgba(15,23,42,.04);border:1px solid #e2e8f0}
  .section h2{font-size:18px;color:#6366f1;margin-bottom:16px;display:flex;align-items:center;gap:8px}
  .section h2::before{content:'';width:4px;height:24px;background:#6366f1;border-radius:2px}
  .step{background:#f8fafc;padding:14px 18px;border-radius:10px;margin-bottom:10px;border-right:3px solid #6366f1}
  .word-card{background:#fef3c7;padding:14px;border-radius:10px;margin-bottom:10px;border-right:3px solid #f59e0b}
  .word-card .w{font-size:18px;font-weight:700;color:#92400e}
  .word-card .t{color:#475569;margin:4px 0}
  .word-card .s{font-size:13px;color:#64748b;font-style:italic}
  .question{background:#eff6ff;padding:16px;border-radius:10px;margin-bottom:12px;border-right:3px solid #3b82f6}
  .question .q{font-weight:600;margin-bottom:10px;color:#1e40af}
  .question .opt{padding:8px 12px;background:#fff;border-radius:8px;margin-bottom:6px;border:1px solid #dbeafe;cursor:pointer;transition:.2s}
  .question .opt:hover{background:#dbeafe;border-color:#3b82f6}
  .question .opt.correct{background:#dcfce7;border-color:#22c55e;color:#166534;font-weight:600}
  .text-card{background:#f1f5f9;padding:16px;border-radius:10px;margin-bottom:10px;border-right:3px solid #64748b}
  .text-card .lvl{display:inline-block;background:#6366f1;color:#fff;padding:2px 10px;border-radius:12px;font-size:11px;margin-bottom:8px}
  .text-card .content{font-size:14px;color:#334155;white-space:pre-wrap}
  .back-btn{display:inline-flex;align-items:center;gap:6px;background:#fff;color:#6366f1;padding:10px 16px;border-radius:10px;text-decoration:none;font-weight:600;margin-bottom:16px;border:1px solid #e2e8f0;transition:.2s}
  .back-btn:hover{background:#6366f1;color:#fff}
  .loading{text-align:center;padding:60px;color:#64748b}
  .complete-btn{background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;padding:14px 28px;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;margin-top:20px;width:100%;box-shadow:0 4px 12px rgba(34,197,94,.3)}
  .complete-btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(34,197,94,.4)}
  .complete-btn:disabled{opacity:.6;cursor:not-allowed}
</style>
</head>
<body>
<div class="container">
  <a href="javascript:history.back()" class="back-btn">← العودة للدروس</a>
  <div id="content" class="loading">⏳ جاري تحميل الدرس...</div>
</div>
<script>
const LESSON_ID = {{ lesson_id }};
const studentId = new URLSearchParams(window.location.search).get('student_id');

async function loadLesson(){
  try{
    const r = await fetch(`/api/lessons/${LESSON_ID}`);
    if(!r.ok) throw new Error('not found');
    const d = await r.json();
    render(d);
  }catch(e){
    document.getElementById('content').innerHTML = '<p style="color:#ef4444">❌ تعذر تحميل الدرس</p>';
  }
}

function render(d){
  const L = d.lesson || {};
  const exp = L.explanation || {};
  let html = `
    <div class="header">
      ${L.lesson_code ? `<div class="code">${L.lesson_code}</div>` : ''}
      <h1>${L.title || 'الدرس'}</h1>
      ${L.focus_point ? `<div class="focus">${L.focus_point}</div>` : ''}
      <div class="meta">
        <span>🎯 +${L.xp_reward||20} XP</span>
        <span>📚 ${L.skill || 'reading'}</span>
        <span>📊 المرحلة ${L.stage||1}</span>
      </div>
    </div>`;

  // Explanation
  if(exp && Object.keys(exp).length){
    html += '<div class="section"><h2>📖 الشرح</h2>';
    if(Array.isArray(exp.steps)){
      exp.steps.forEach((s,i)=>{
        const text = typeof s==='string' ? s : (s.text||s.content||JSON.stringify(s));
        html += `<div class="step"><b>${i+1}.</b> ${text}</div>`;
      });
    } else if(typeof exp === 'object'){
      Object.entries(exp).forEach(([k,v])=>{
        if(typeof v === 'string') html += `<div class="step"><b>${k}:</b> ${v}</div>`;
      });
    }
    html += '</div>';
  }

  // Words
  if(d.words && d.words.length){
    html += `<div class="section"><h2>🔤 المفردات (${d.words.length})</h2>`;
    d.words.forEach(w=>{
      html += `<div class="word-card"><div class="w">${w.word}</div><div class="t">${w.translation||''}</div>${w.sentence?`<div class="s">"${w.sentence}"</div>`:''}</div>`;
    });
    html += '</div>';
  }

  // Texts
  if(d.texts && d.texts.length){
    html += `<div class="section"><h2>📄 نصوص تطبيقية (${d.texts.length})</h2>`;
    d.texts.forEach(t=>{
      html += `<div class="text-card"><span class="lvl">${t.level||'مستوى'}</span><div class="content">${(t.content||'').substring(0,500)}${(t.content||'').length>500?'...':''}</div></div>`;
    });
    html += '</div>';
  }

  // Questions
  if(d.questions && d.questions.length){
    html += `<div class="section"><h2>❓ الأسئلة (${d.questions.length})</h2>`;
    d.questions.forEach((q,i)=>{
      let opts='';
      try{
        const o = JSON.parse(q.options_json||'[]');
        if(Array.isArray(o)){
          o.forEach((opt,j)=>{
            const letter = String.fromCharCode(65+j);
            const isCorrect = q.correct_answer === letter || q.correct_answer === opt;
            opts += `<div class="opt ${isCorrect?'correct':''}">${letter}. ${opt}${isCorrect?' ✓':''}</div>`;
          });
        }
      }catch(e){}
      html += `<div class="question"><div class="q">${i+1}. ${q.question}</div>${opts}</div>`;
    });
    html += '</div>';
  }

  html += `<button class="complete-btn" onclick="completeLesson()">✅ إنهاء الدرس واستلام +${L.xp_reward||20} XP</button>`;
  document.getElementById('content').innerHTML = html;
}

async function completeLesson(){
  if(!studentId){ alert('⚠️ افتح الدرس من بوابة الطالب لاستلام XP'); return; }
  const btn = document.querySelector('.complete-btn');
  btn.disabled = true; btn.textContent = '⏳ جاري الحفظ...';
  try{
    const r = await fetch(`/api/lessons/${LESSON_ID}/complete`,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({user_id: parseInt(studentId)})
    });
    const d = await r.json();
    if(d.ok){
      btn.textContent = `🎉 تم! حصلت على +${d.xp_awarded} XP`;
      setTimeout(()=>{ window.location.href = '/student?student_id='+studentId; }, 1500);
    } else {
      btn.disabled=false; btn.textContent='❌ فشل - حاول مرة أخرى';
    }
  }catch(e){
    btn.disabled=false; btn.textContent='❌ خطأ في الاتصال';
  }
}

loadLesson();
</script>
</body>
</html>