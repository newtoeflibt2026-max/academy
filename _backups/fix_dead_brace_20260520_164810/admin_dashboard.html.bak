<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>لوحة تحكم يامن</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<style>
*{font-family:Cairo,sans-serif;box-sizing:border-box;margin:0;padding:0}
body{background:#0f172a;color:#e2e8f0;display:flex;min-height:100vh}
/* Sidebar */
.sb{width:250px;min-width:250px;background:#1e293b;height:100vh;overflow-y:auto;position:fixed;right:0;top:0;border-left:1px solid #334155;z-index:100}
.sb-brand{padding:18px 16px;border-bottom:1px solid #334155;display:flex;align-items:center;gap:10px}
.sb-icon{width:40px;height:40px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.sb-title{font-size:14px;font-weight:700;color:#f1f5f9}
.sb-sub{font-size:11px;color:#64748b}
.sb-sec{padding:10px 16px 4px;font-size:10px;font-weight:700;color:#475569;text-transform:uppercase}
.nav{display:flex;align-items:center;gap:8px;padding:9px 14px;margin:1px 8px;border-radius:8px;cursor:pointer;color:#94a3b8;font-size:13px;font-weight:500;transition:.2s}
.nav:hover{background:#334155;color:#f1f5f9}
.nav.on{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;font-weight:700}
.nb{margin-right:auto;background:#ef4444;color:#fff;border-radius:99px;padding:1px 6px;font-size:10px}
/* Main */
.main{margin-right:250px;flex:1;display:flex;flex-direction:column;min-height:100vh}
.topbar{background:#1e293b;border-bottom:1px solid #334155;padding:12px 20px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:50}
.topbar h1{font-size:16px;font-weight:700;color:#f1f5f9;margin-right:auto}
.ic{width:36px;height:36px;background:#334155;border:none;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:15px}
.ic:hover{background:#475569;color:#f1f5f9}
.content{padding:20px;flex:1}
/* Cards */
.card{background:#1e293b;border-radius:14px;border:1px solid #334155;padding:18px;margin-bottom:16px}
.ch{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.ct{font-size:14px;font-weight:700;color:#f1f5f9}
/* Stats */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:16px}
.stat{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:16px;display:flex;align-items:center;gap:12px}
.si{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.sv{font-size:22px;font-weight:800;color:#f1f5f9}
.sl{font-size:11px;color:#64748b}
/* Table */
.tbl{width:100%;border-collapse:collapse}
.tbl th{padding:9px 12px;text-align:right;font-size:11px;font-weight:700;color:#64748b;background:#0f172a;border-bottom:1px solid #334155}
.tbl td{padding:11px 12px;border-bottom:1px solid #1e293b;font-size:13px;color:#cbd5e1;vertical-align:middle}
.tbl tr:hover td{background:#1e293b55}
/* Badges */
.bg{display:inline-flex;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600}
.bg-g{background:#052e16;color:#4ade80}
.bg-r{background:#1c0005;color:#f87171}
.bg-b{background:#1e3a5f;color:#60a5fa}
.bg-y{background:#2d1b00;color:#fbbf24}
.bg-p{background:#2e1065;color:#a78bfa}
/* Buttons */
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:.2s;font-family:Cairo,sans-serif}
.btn-p{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff}
.btn-p:hover{opacity:.9}
.btn-g{background:#166534;color:#4ade80}
.btn-g:hover{background:#15803d}
.btn-d{background:#7f1d1d;color:#f87171}
.btn-d:hover{background:#991b1b}
.btn-gh{background:#334155;color:#94a3b8}
.btn-gh:hover{background:#475569;color:#f1f5f9}
.btn-sm{padding:4px 9px;font-size:12px}
/* Form */
.fg{margin-bottom:12px}
.fl{display:block;font-size:12px;font-weight:600;color:#94a3b8;margin-bottom:5px}
.fc{width:100%;background:#0f172a;border:1px solid #334155;border-radius:8px;padding:8px 12px;color:#f1f5f9;font-size:13px;font-family:Cairo,sans-serif;transition:.2s}
.fc:focus{outline:none;border-color:#6366f1}
.fc option{background:#1e293b}
/* Modal */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:200;display:none;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:#1e293b;border-radius:16px;border:1px solid #334155;width:90%;max-width:540px;max-height:90vh;overflow-y:auto}
.mh{padding:18px 20px;border-bottom:1px solid #334155;display:flex;align-items:center;justify-content:space-between}
.mt{font-size:15px;font-weight:700;color:#f1f5f9}
.mb{padding:20px}
.mf{padding:14px 20px;border-top:1px solid #334155;display:flex;justify-content:flex-end;gap:8px}
/* Page */
.pg{display:none}.pg.on{display:block}
/* Toast */
#toast{position:fixed;bottom:20px;left:20px;background:#1e293b;border:1px solid #334155;color:#f1f5f9;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:600;z-index:999;display:none;gap:8px;align-items:center;box-shadow:0 8px 24px rgba(0,0,0,.4)}
#toast.on{display:flex}
#toast.ok{border-left:3px solid #4ade80}
#toast.er{border-left:3px solid #f87171}
/* Upload zone */
.drop-zone{border:2px dashed #334155;border-radius:12px;padding:30px;text-align:center;cursor:pointer;transition:.2s;color:#64748b}
.drop-zone:hover,.drop-zone.drag{border-color:#6366f1;background:rgba(99,102,241,.05);color:#a5b4fc}
@media(max-width:768px){.sb{transform:translateX(100%)}.sb.open{transform:translateX(0)}.main{margin-right:0}}
</style>
</head>
<body>

<nav class="sb" id="sb">
  <div class="sb-brand">
    <div class="sb-icon">🎓</div>
    <div><div class="sb-title">أكاديمية يامن</div><div class="sb-sub">لوحة التحكم</div></div>
  </div>
  <div class="sb-sec">عام</div>
  <div class="nav on" onclick="go('dashboard',this)"><span>📊</span> الرئيسية</div>
  <div class="nav" onclick="go('students',this)"><span>👥</span> الطلاب <span class="nb" id="nb-students">0</span></div>
  <div class="sb-sec">المحتوى</div>
  <div class="nav" onclick="go('lessons',this)"><span>📚</span> الدروس</div>
  <div class="nav" onclick="go('questions',this)"><span>❓</span> الأسئلة</div>
  <div class="nav" onclick="go('missions',this)"><span>🎯</span> المهام</div>
  <div class="sb-sec">التقييم</div>
  <div class="nav" onclick="go('grading',this)"><span>✍️</span> التصحيح</div>
  <div class="nav" onclick="go('phases',this)"><span>🔄</span> المراحل</div>
  <div class="nav" onclick="go('graduation',this)"><span>🎓</span> التخرج</div>
  <div class="sb-sec">المالية</div>
  <div class="nav" onclick="go('plans',this)"><span>📦</span> الباقات</div>
  <div class="nav" onclick="go('payments',this)"><span>💳</span> المدفوعات</div>
  <div class="sb-sec">التواصل</div>
  <div class="nav" onclick="go('broadcast',this)"><span>📨</span> رسائل جماعية</div>
  <div class="nav" onclick="go('messages',this)"><span>💬</span> رسائل الطلاب <span class="nb" id="nb-msgs">0</span></div>
  <div class="sb-sec">النظام</div>
  <div class="nav" onclick="go('settings',this)"><span>⚙️</span> الإعدادات</div>
  <div class="nav" onclick="window.open('/student','_blank')"><span>🌐</span> بوابة الطالب</div>
</nav>

<div class="main">
  <div class="topbar">
    <button class="ic" onclick="document.getElementById('sb').classList.toggle('open')">☰</button>
    <h1 id="page-title">الرئيسية</h1>
    <button class="ic" onclick="refresh()" title="تحديث">🔄</button>
    <div style="width:34px;height:34px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:50%;display:flex;align-items:center;justify-content:center">👤</div>
  </div>
  <div class="content">

    <!-- DASHBOARD -->
    <div class="pg on" id="pg-dashboard">
      <div class="stats" id="stats-grid"></div>
      <div class="card">
        <div class="ch"><span class="ct">🏆 المتصدرون</span></div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-leaders"><thead><tr><th>#</th><th>الطالب</th><th>XP</th><th>Streak</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- STUDENTS -->
    <div class="pg" id="pg-students">
      <div class="card">
        <div class="ch">
          <span class="ct">👥 الطلاب</span>
          <button class="btn btn-p btn-sm" onclick="document.getElementById('modalAddStudent').classList.add('open')">&#43; إضافة طالب</button>
          <input class="fc" id="s-search" placeholder="🔍 بحث..." oninput="searchStudents()" style="width:260px"/>
        </div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-students"><thead><tr><th>ID</th><th>الاسم</th><th>المستخدم</th><th>XP</th><th>Streak</th><th>النوع</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- LESSONS -->
    <div class="pg" id="pg-lessons">
      <div class="card">
        <div class="ch">
          <span class="ct">📚 الدروس</span>
          <button class="btn btn-p" onclick="openModal('m-lesson')">➕ إضافة درس</button>
        </div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-lessons"><thead><tr><th>#</th><th>العنوان</th><th>المهارة</th><th>المرحلة</th><th>الترتيب</th><th>XP</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- QUESTIONS -->
    <div class="pg" id="pg-questions">
      <div class="card">
        <div class="ch">
          <span class="ct">❓ الأسئلة</span>
          <div style="display:flex;gap:8px">
            <select class="fc" id="q-skill-filter" onchange="loadQuestions()" style="width:140px">
              <option value="">كل المهارات</option>
              <option value="reading">قراءة</option>
              <option value="listening">استماع</option>
              <option value="speaking">محادثة</option>
              <option value="writing">كتابة</option>
              <option value="grammar">قواعد</option>
              <option value="vocabulary">مفردات</option>
            </select>
            <button class="btn btn-p" onclick="openModal('m-question')">➕ إضافة</button>
            <button class="btn btn-gh" onclick="openModal('m-import')">📥 استيراد CSV</button>
          </div>
        </div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-questions"><thead><tr><th>#</th><th>السؤال</th><th>النوع</th><th>المهارة</th><th>إجراءات</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- MISSIONS -->
    <div class="pg" id="pg-missions">
      <div class="card">
        <div class="ch"><span class="ct">🎯 المهام اليومية</span><button class="btn btn-p" onclick="openModal('m-mission')">➕ إضافة</button></div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-missions"><thead><tr><th>#</th><th>العنوان</th><th>النوع</th><th>XP</th><th>التاريخ</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- GRADING -->
    <div class="pg" id="pg-grading">
      <div class="card">
        <div class="ch"><span class="ct">✍️ معايير التصحيح</span><button class="btn btn-p" onclick="openModal('m-grading')">➕ إضافة</button></div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-grading"><thead><tr><th>#</th><th>الموضوع</th><th>المهارة</th><th>Vocab</th><th>Connectors</th><th>Max</th><th>إجراءات</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- PHASES -->
    <div class="pg" id="pg-phases">
      <div class="card">
        <div class="ch"><span class="ct">🔄 شروط الانتقال</span></div>
        <div id="phases-cont"></div>
      </div>
    </div>

    <!-- GRADUATION -->
    <div class="pg" id="pg-graduation">
      <div class="card">
        <div class="ch"><span class="ct">🎓 شروط التخرج</span><button class="btn btn-p" onclick="saveGrad()">💾 حفظ</button></div>
        <div id="grad-form" style="display:grid;grid-template-columns:1fr 1fr;gap:12px"></div>
      </div>
      <div class="card">
        <div class="ch"><span class="ct">🔍 تحقق من طالب</span></div>
        <div style="display:flex;gap:8px;margin-bottom:12px">
          <input class="fc" id="grad-uid" placeholder="Telegram ID" style="max-width:220px"/>
          <button class="btn btn-p" onclick="checkGrad()">تحقق</button>
        </div>
        <div id="grad-result"></div>
      </div>
    </div>

    <!-- PLANS -->
    <div class="pg" id="pg-plans">
      <div class="card">
        <div class="ch"><span class="ct">📦 الباقات</span><button class="btn btn-p" onclick="openPlanModal()">➕ إضافة</button></div>
        <div id="plans-cont" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-top:8px"></div>
      </div>
    </div>

    <!-- PAYMENTS -->
    <div class="pg" id="pg-payments">
      <div class="card">
        <div class="ch"><span class="ct">💳 المدفوعات</span></div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-payments"><thead><tr><th>#</th><th>الطالب</th><th>المبلغ</th><th>الخطة</th><th>الحالة</th><th>التاريخ</th><th>إجراءات</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- BROADCAST -->
    <div class="pg" id="pg-broadcast">
      <div class="card">
        <div class="ch"><span class="ct">📨 إرسال رسائل Telegram</span></div>
        <div class="fg">
          <label class="fl">المستهدف</label>
          <select class="fc" id="bc-target" onchange="toggleBcTarget()" style="max-width:280px">
            <option value="all">📢 جميع الطلاب</option>
            <option value="single">👤 طالب محدد</option>
          </select>
        </div>
        <div class="fg" id="bc-uid-wrap" style="display:none;max-width:280px">
          <label class="fl">Telegram ID</label>
          <input class="fc" id="bc-uid" placeholder="123456789"/>
        </div>
        <div class="fg">
          <label class="fl">الرسالة</label>
          <textarea class="fc" id="bc-msg" rows="5" placeholder="اكتب رسالتك..."></textarea>
        </div>
        <div style="display:flex;align-items:center;gap:12px">
          <button class="btn btn-p" onclick="sendBC()">📨 إرسال</button>
          <span id="bc-status" style="font-size:13px;color:#64748b"></span>
        </div>
      </div>
      <div class="card">
        <div class="ch"><span class="ct">📋 سجل الإرسال</span></div>
        <div style="overflow-x:auto"><table class="tbl" id="tbl-bc"><thead><tr><th>الرسالة</th><th>المستهدف</th><th>أُرسل</th><th>الحالة</th><th>التاريخ</th></tr></thead><tbody></tbody></table></div>
      </div>
    </div>

    <!-- MESSAGES -->
    <div class="pg" id="pg-messages">
      <div class="card">
        <div class="ch"><span class="ct">💬 رسائل الطلاب</span><button class="btn btn-gh btn-sm" onclick="loadMsgs()">🔄</button></div>
        <div id="msgs-cont"></div>
      </div>
    </div>

    <!-- SETTINGS -->
    <div class="pg" id="pg-settings">
      <div class="card">
        <div class="ch"><span class="ct">⚙️ إعدادات النظام</span><button class="btn btn-p" onclick="saveSettings()">💾 حفظ</button></div>
        <div id="settings-form" style="display:grid;grid-template-columns:1fr 1fr;gap:12px"></div>
      </div>
    </div>

  </div>
</div>

<!-- MODALS -->
<div class="modal-bg" id="m-lesson">
  <div class="modal">
    <div class="mh"><span class="mt" id="m-lesson-t">➕ درس جديد</span><button class="ic" onclick="closeModal('m-lesson')">✕</button></div>
    <div class="mb">
      <input type="hidden" id="l-id"/>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="fg" style="grid-column:1/-1"><label class="fl">العنوان</label><input class="fc" id="l-title" placeholder="عنوان الدرس"/></div>
        <div class="fg"><label class="fl">المهارة</label><select class="fc" id="l-skill"><option value="reading">قراءة</option><option value="listening">استماع</option><option value="speaking">محادثة</option><option value="writing">كتابة</option><option value="grammar">قواعد</option><option value="vocabulary">مفردات</option></select></div>
        <div class="fg"><label class="fl">المرحلة</label><select class="fc" id="l-phase"><option value="1">مرحلة 1</option><option value="2">مرحلة 2</option><option value="3">مرحلة 3</option></select></div>
        <div class="fg"><label class="fl">الترتيب</label><input class="fc" id="l-order" type="number" value="0"/></div>
        <div class="fg"><label class="fl">XP مكافأة</label><input class="fc" id="l-xp" type="number" value="10"/></div>
        <div class="fg" style="grid-column:1/-1"><label class="fl">الوصف</label><input class="fc" id="l-desc" placeholder="وصف مختصر"/></div>
        <div class="fg" style="grid-column:1/-1"><label class="fl">المحتوى</label><textarea class="fc" id="l-content" rows="4" placeholder="محتوى الدرس الكامل..."></textarea></div>
      </div>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:#94a3b8;cursor:pointer"><input type="checkbox" id="l-active" checked style="accent-color:#6366f1"/> درس نشط</label>
    </div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-lesson')">إلغاء</button><button class="btn btn-p" onclick="saveLesson()">💾 حفظ</button></div>
  </div>
</div>

<div class="modal-bg" id="m-question">
  <div class="modal">
    <div class="mh"><span class="mt">➕ سؤال جديد</span><button class="ic" onclick="closeModal('m-question')">✕</button></div>
    <div class="mb">
      <div class="fg"><label class="fl">المهارة</label><select class="fc" id="q-skill"><option value="reading">قراءة</option><option value="listening">استماع</option><option value="speaking">محادثة</option><option value="writing">كتابة</option><option value="grammar">قواعد</option><option value="vocabulary">مفردات</option></select></div>
      <div class="fg"><label class="fl">النوع</label><select class="fc" id="q-type"><option value="mcq">اختيار متعدد</option><option value="true_false">صح/خطأ</option><option value="fill">تعبئة</option><option value="essay">مقالي</option></select></div>
      <div class="fg"><label class="fl">نص السؤال</label><textarea class="fc" id="q-text" rows="3" placeholder="السؤال..."></textarea></div>
      <div class="fg"><label class="fl">الخيارات (كل خيار في سطر)</label><textarea class="fc" id="q-opts" rows="4" placeholder="خيار أ&#10;خيار ب&#10;خيار ج&#10;خيار د"></textarea></div>
      <div class="fg"><label class="fl">الإجابة الصحيحة</label><input class="fc" id="q-ans" placeholder="الإجابة"/></div>
      <div class="fg"><label class="fl">الشرح (اختياري)</label><textarea class="fc" id="q-exp" rows="2" placeholder="شرح الإجابة..."></textarea></div>
    </div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-question')">إلغاء</button><button class="btn btn-p" onclick="saveQuestion()">💾 حفظ</button></div>
  </div>
</div>

<div class="modal-bg" id="m-import">
  <div class="modal">
    <div class="mh"><span class="mt">📥 استيراد أسئلة</span><button class="ic" onclick="closeModal('m-import')">✕</button></div>
    <div class="mb">
      <p style="font-size:13px;color:#94a3b8;margin-bottom:14px">ارفع ملف CSV بالأعمدة التالية:</p>
      <code style="display:block;background:#0f172a;padding:10px;border-radius:8px;font-size:12px;color:#a5b4fc;margin-bottom:14px">question_text, skill, question_type, option_a, option_b, option_c, option_d, correct_answer, explanation</code>
      <div class="drop-zone" id="drop-zone" onclick="document.getElementById('csv-file').click()" ondragover="event.preventDefault();this.classList.add('drag')" ondragleave="this.classList.remove('drag')" ondrop="handleDrop(event)">
        <div style="font-size:32px;margin-bottom:8px">📂</div>
        <div style="font-weight:600;margin-bottom:4px">اسحب ملف CSV هنا أو اضغط للاختيار</div>
        <div style="font-size:12px">يدعم: .csv</div>
      </div>
      <input type="file" id="csv-file" accept=".csv" style="display:none" onchange="uploadCSV(this)"/>
      <div id="import-status" style="margin-top:10px;font-size:13px;color:#64748b"></div>
    </div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-import')">إغلاق</button></div>
  </div>
</div>

<div class="modal-bg" id="m-mission">
  <div class="modal">
    <div class="mh"><span class="mt">➕ مهمة يومية</span><button class="ic" onclick="closeModal('m-mission')">✕</button></div>
    <div class="mb">
      <div class="fg"><label class="fl">العنوان</label><input class="fc" id="ms-title" placeholder="اقرأ 10 جمل..."/></div>
      <div class="fg"><label class="fl">الوصف</label><textarea class="fc" id="ms-desc" rows="2"></textarea></div>
      <div class="fg"><label class="fl">النوع</label><select class="fc" id="ms-type"><option value="reading">قراءة</option><option value="listening">استماع</option><option value="speaking">محادثة</option><option value="writing">كتابة</option><option value="vocabulary">مفردات</option><option value="grammar">قواعد</option></select></div>
      <div class="fg"><label class="fl">XP</label><input class="fc" id="ms-xp" type="number" value="20"/></div>
      <div class="fg"><label class="fl">تاريخ التفعيل (اختياري)</label><input class="fc" id="ms-date" type="date"/></div>
    </div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-mission')">إلغاء</button><button class="btn btn-p" onclick="saveMission()">💾 حفظ</button></div>
  </div>
</div>

<div class="modal-bg" id="m-grading">
  <div class="modal">
    <div class="mh"><span class="mt">➕ معيار تصحيح</span><button class="ic" onclick="closeModal('m-grading')">✕</button></div>
    <div class="mb">
      <div class="fg"><label class="fl">الموضوع</label><input class="fc" id="gr-topic" placeholder="Environment..."/></div>
      <div class="fg"><label class="fl">المهارة</label><select class="fc" id="gr-skill"><option value="writing">كتابة</option><option value="speaking">محادثة</option></select></div>
      <div class="fg"><label class="fl">Vocab Keywords (مفصولة بفاصلة)</label><textarea class="fc" id="gr-vocab" rows="2" placeholder="pollution,environment,climate"></textarea></div>
      <div class="fg"><label class="fl">Connectors (مفصولة بفاصلة)</label><textarea class="fc" id="gr-conn" rows="2" placeholder="however,therefore,furthermore"></textarea></div>
      <div class="fg"><label class="fl">كلمات محظورة (مفصولة بفاصلة)</label><textarea class="fc" id="gr-forb" rows="2" placeholder="stuff,things"></textarea></div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
        <div class="fg"><label class="fl">نقاط Vocab</label><input class="fc" id="gr-vp" type="number" value="2" step="0.5"/></div>
        <div class="fg"><label class="fl">نقاط Connectors</label><input class="fc" id="gr-cp" type="number" value="3" step="0.5"/></div>
        <div class="fg"><label class="fl">خصم المحظور</label><input class="fc" id="gr-fp" type="number" value="1" step="0.5"/></div>
      </div>
      <div class="fg"><label class="fl">الدرجة القصوى</label><input class="fc" id="gr-max" type="number" value="100"/></div>
    </div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-grading')">إلغاء</button><button class="btn btn-p" onclick="saveGrading()">💾 حفظ</button></div>
  </div>
</div>

<div class="modal-bg" id="m-plan">
  <div class="modal">
    <div class="mh"><span class="mt" id="m-plan-t">➕ باقة جديدة</span><button class="ic" onclick="closeModal('m-plan')">✕</button></div>
    <div class="mb">
      <input type="hidden" id="pl-id"/>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="fg"><label class="fl">الاسم (EN)</label><input class="fc" id="pl-name" placeholder="basic"/></div>
        <div class="fg"><label class="fl">الاسم بالعربي</label><input class="fc" id="pl-name-ar" placeholder="الباقة الأساسية"/></div>
        <div class="fg"><label class="fl">السعر (د.ع)</label><input class="fc" id="pl-price" type="number" placeholder="25000"/></div>
        <div class="fg"><label class="fl">المدة (أيام)</label><input class="fc" id="pl-days" type="number" value="30"/></div>
      </div>
      <div class="fg"><label class="fl">الوصف</label><input class="fc" id="pl-desc"/></div>
      <div class="fg"><label class="fl">المميزات (كل ميزة في سطر)</label><textarea class="fc" id="pl-feats" rows="4" placeholder="الوصول للدروس&#10;المهام اليومية&#10;Mock Exam"></textarea></div>
      <div style="display:flex;gap:20px;margin-top:8px">
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:#94a3b8;cursor:pointer"><input type="checkbox" id="pl-active" checked style="accent-color:#6366f1"/> نشطة</label>
        <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:#94a3b8;cursor:pointer"><input type="checkbox" id="pl-feat" style="accent-color:#f59e0b"/> موصى بها ⭐</label>
      </div>
    </div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-plan')">إلغاء</button><button class="btn btn-p" onclick="savePlan()">💾 حفظ</button></div>
  </div>
</div>

<div class="modal-bg" id="m-activate">
  <div class="modal" style="max-width:400px">
    <div class="mh"><span class="mt">💳 تفعيل حساب</span><button class="ic" onclick="closeModal('m-activate')">✕</button></div>
    <div class="mb" id="m-activate-body"></div>
    <div class="mf"><button class="btn btn-gh" onclick="closeModal('m-activate')">إلغاء</button><button class="btn btn-g" onclick="confirmActivate()">✅ تفعيل</button></div>
  </div>
</div>

<div id="toast"><span id="toast-ico">✅</span><span id="toast-msg"></span></div>

<script>
const PAGES={dashboard:'الرئيسية',students:'الطلاب',lessons:'الدروس',questions:'الأسئلة',missions:'المهام',grading:'التصحيح',phases:'المراحل',graduation:'التخرج',plans:'الباقات',payments:'المدفوعات',broadcast:'رسائل جماعية',messages:'رسائل الطلاب',settings:'الإعدادات'};
const LOADERS={dashboard:loadDash,students:loadStudents,lessons:loadLessons,questions:loadQuestions,missions:loadMissions,grading:loadGrading,phases:loadPhases,graduation:loadGraduation,plans:loadPlans,payments:loadPayments,broadcast:loadBCHistory,messages:loadMsgs,settings:loadSettings};

async function API(url,method,body){
  const o={method:method||'GET',headers:{'Content-Type':'application/json'}};
  if(body) o.body=JSON.stringify(body);
  const r=await fetch(url,o);
  return r.json();
}
function toast(msg,type){
  const t=document.getElementById('toast');
  document.getElementById('toast-msg').textContent=msg;
  document.getElementById('toast-ico').textContent=type==='error'?'❌':'✅';
  t.className='on '+(type==='error'?'er':'ok');
  setTimeout(()=>t.className='',3000);
}
function openModal(id){document.getElementById(id).classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}
function go(name,el){
  document.querySelectorAll('.pg').forEach(p=>p.classList.remove('on'));
  document.querySelectorAll('.nav').forEach(n=>n.classList.remove('on'));
  const pg=document.getElementById('pg-'+name);
  if(pg) pg.classList.add('on');
  if(el) el.classList.add('on');
  document.getElementById('page-title').textContent=PAGES[name]||name;
  if(LOADERS[name]) LOADERS[name]();
}
function refresh(){const t=document.getElementById('page-title').textContent;const k=Object.entries(PAGES).find(([k,v])=>v===t)?.[0];if(k&&LOADERS[k])LOADERS[k]();}

// DASHBOARD
async function loadDash(){
  const d=await API('/api/admin/stats');
  const c=d.counts||{};
  document.getElementById('stats-grid').innerHTML=`
    <div class="stat"><div class="si" style="background:#1e3a5f">👥</div><div><div class="sl">الطلاب</div><div class="sv">${c.total||0}</div></div></div>
    <div class="stat"><div class="si" style="background:#052e16">💳</div><div><div class="sl">مدفوعون</div><div class="sv">${c.paid||0}</div></div></div>
    <div class="stat"><div class="si" style="background:#2e1065">⚡</div><div><div class="sl">نشطون</div><div class="sv">${c.active||0}</div></div></div>
    <div class="stat"><div class="si" style="background:#2d1b00">❓</div><div><div class="sl">أسئلة</div><div class="sv">${d.question_count||0}</div></div></div>`;
  document.getElementById('nb-students').textContent=c.total||0;
  const tb=document.querySelector('#tbl-leaders tbody');
  tb.innerHTML='';
  const md=['🥇','🥈','🥉'];
  (d.leaderboard||[]).forEach((s,i)=>{
    tb.innerHTML+=`<tr><td>${md[i]||'🏅'}</td><td><b>${s.full_name||s.username||'#'+s.user_id}</b></td><td><span class="bg bg-p">${s.xp} XP</span></td><td>🔥${s.streak||0}</td></tr>`;
  });
}

// STUDENTS
let _sTimer;
function searchStudents(){clearTimeout(_sTimer);_sTimer=setTimeout(()=>loadStudents(document.getElementById('s-search').value.trim()),400);}
async function loadStudents(q='') {
  const d = await API('/api/admin/students' + (q ? '?q=' + encodeURIComponent(q) : ''));
  const tb = document.querySelector('#tbl-students tbody');
  if (!tb) return;
  tb.innerHTML = '';
  (d.students || []).forEach(s => {
    const paid = s.is_paid ? '✅ مفعّل' : '⏳ غير مفعّل';
    const paidClass = s.is_paid ? 'bg-success' : 'bg-warning';
    const uid = s.user_id || s.telegram_id;
    tb.innerHTML += `<tr>
      <td>${uid}</td>
      <td>${s.full_name || s.name || '-'}</td>
      <td>${s.username ? '@'+s.username : '-'}</td>
      <td>${s.level || 'beginner'}</td>
      <td><span class="bg ${paidClass}">${paid}</span></td>
      <td>${s.xp || 0}</td>
      <td style="display:flex;gap:4px;flex-wrap:wrap">
        ${s.is_paid
          ? `<button class="btn btn-d btn-sm" onclick="deactivateStudent(${uid})">🚫 إلغاء</button>`
          : `<button class="btn btn-g btn-sm" onclick="activateStudent(${uid})">✅ تفعيل</button>`
        }
        <button class="btn btn-gh btn-sm" onclick="sendMsgToStudent(${uid})">💬 رسالة</button>
        <button class="btn btn-d btn-sm" onclick="deleteStudent(${uid})">🗑️ حذف</button>
      </td>
    </tr>`;
  });
}
let _actUID=null;
function openActivate(uid,name){_actUID=uid;document.getElementById('m-activate-body').innerHTML='<p>تفعيل حساب <b>'+name+'</b> (ID: '+uid+')?</p><p style="color:#64748b;font-size:12px;margin-top:8px">سيتمكن من الوصول لـ Mock Exam والتخرج.</p>';openModal('m-activate');}
async function confirmActivate(){if(!_actUID)return;const r=await API('/api/admin/students/'+_actUID+'/activate','POST');if(r.ok){toast('✅ تم التفعيل');closeModal('m-activate');loadStudents();}else toast(r.error||'خطأ','error');}
async function togglePaid(uid,act){const r=await API('/api/admin/students/'+uid+'/'+(act?'activate':'deactivate'),'POST');if(r.ok){toast(act?'✅ تم التفعيل':'🔒 تم الإلغاء');loadStudents();}else toast('خطأ','error');}
async function toggleActive(uid){const r=await API('/api/admin/students/'+uid+'/toggle-active','POST');if(r.ok){toast('تم التحديث');loadStudents();}else toast('خطأ','error');}

// LESSONS
async function loadLessons(){
  const d=await API('/api/admin/lessons');
  const tb=document.querySelector('#tbl-lessons tbody');
  tb.innerHTML='';
  const sc={reading:'bg-b',listening:'bg-p',speaking:'bg-y',writing:'bg-g',grammar:'bg-r',vocabulary:'bg-y'};
  (d.lessons||[]).forEach(l=>{
    tb.innerHTML+=`<tr><td style="color:#64748b">${l.id}</td><td><b>${l.title}</b><br><small style="color:#64748b">${l.description||''}</small></td><td><span class="bg ${sc[l.skill]||'bg-b'}">${l.skill}</span></td><td>م${l.phase}</td><td>${l.order_num}</td><td><span class="bg bg-p">+${l.xp_reward}XP</span></td><td><span class="bg ${l.is_active?'bg-g':'bg-r'}">${l.is_active?'نشط':'موقوف'}</span></td><td style="display:flex;gap:4px"><button class="btn btn-gh btn-sm" onclick="editLesson(${l.id})">✏️</button><button class="btn btn-d btn-sm" onclick="delLesson(${l.id})">🗑️</button></td></tr>`;
  });
}
function openLessonModal(r){
  if(r!==false){document.getElementById('m-lesson-t').textContent='➕ درس جديد';document.getElementById('l-id').value='';['l-title','l-desc','l-content'].forEach(id=>document.getElementById(id).value='');document.getElementById('l-skill').value='reading';document.getElementById('l-phase').value='1';document.getElementById('l-order').value='0';document.getElementById('l-xp').value='10';document.getElementById('l-active').checked=true;}
  openModal('m-lesson');
}
async function editLesson(id){const d=await API('/api/admin/lessons');const l=(d.lessons||[]).find(x=>x.id===id);if(!l)return;document.getElementById('m-lesson-t').textContent='✏️ تعديل الدرس';document.getElementById('l-id').value=id;document.getElementById('l-title').value=l.title||'';;document.getElementById('l-desc').value=l.description||'';document.getElementById('l-content').value=l.content||'';document.getElementById('l-skill').value=l.skill||'reading';document.getElementById('l-phase').value=l.phase||1;document.getElementById('l-order').value=l.order_num||0;document.getElementById('l-xp').value=l.xp_reward||10;document.getElementById('l-active').checked=!!l.is_active;openLessonModal(false);}
async function saveLesson(){
  const t=document.getElementById('l-title').value.trim();if(!t){toast('العنوان مطلوب','error');return;}
  const id=document.getElementById('l-id').value;
  const p={title:t,description:document.getElementById('l-desc').value.trim(),content:document.getElementById('l-content').value.trim(),skill:document.getElementById('l-skill').value,phase:parseInt(document.getElementById('l-phase').value)||1,order_num:parseInt(document.getElementById('l-order').value)||0,xp_reward:parseInt(document.getElementById('l-xp').value)||10,is_active:document.getElementById('l-active').checked?1:0};
  const r=await API(id?'/api/admin/lessons/'+id:'/api/admin/lessons',id?'PUT':'POST',p);
  if(r.ok){toast(id?'✅ تم التحديث':'✅ تمت الإضافة');closeModal('m-lesson');loadLessons();}else toast(r.error||'خطأ','error');
}
async function delLesson(id){if(!confirm('حذف هذا الدرس؟'))return;const r=await API('/api/admin/lessons/'+id,'DELETE');if(r.ok){toast('🗑️ تم الحذف');loadLessons();}else toast('خطأ','error');}

// QUESTIONS
async function loadQuestions(){
  const sk=document.getElementById('q-skill-filter').value;
  const d=await API('/api/admin/questions'+(sk?'?skill='+sk:''));
  const tb=document.querySelector('#tbl-questions tbody');
  tb.innerHTML='';
  (d.questions||[]).forEach(q=>{
    const txt=q.question_text.length>60?q.question_text.slice(0,60)+'...':q.question_text;
    tb.innerHTML+=`<tr><td style="color:#64748b">${q.id}</td><td title="${q.question_text}">${txt}</td><td><span class="bg bg-b">${q.question_type}</span></td><td><span class="bg bg-p">${q.skill}</span></td><td><button class="btn btn-d btn-sm" onclick="delQuestion(${q.id})">🗑️</button></td></tr>`;
  });
}
async function saveQuestion(){
  const t=document.getElementById('q-text').value.trim();if(!t){toast('نص السؤال مطلوب','error');return;}
  const opts=document.getElementById('q-opts').value.split('\n').map(s=>s.trim()).filter(Boolean);
  const r=await API('/api/admin/questions','POST',{question_text:t,skill:document.getElementById('q-skill').value,question_type:document.getElementById('q-type').value,options:opts.length?opts:null,correct_answer:document.getElementById('q-ans').value.trim(),explanation:document.getElementById('q-exp').value.trim()});
  if(r.ok){toast('✅ تمت الإضافة');closeModal('m-question');['q-text','q-opts','q-ans','q-exp'].forEach(id=>document.getElementById(id).value='');loadQuestions();}else toast(r.error||'خطأ','error');
}
async function delQuestion(id){if(!confirm('حذف؟'))return;const r=await API('/api/admin/questions/'+id,'DELETE');if(r.ok){toast('🗑️ تم الحذف');loadQuestions();}else toast('خطأ','error');}

// CSV Import
function handleDrop(e){e.preventDefault();document.getElementById('drop-zone').classList.remove('drag');const f=e.dataTransfer.files[0];if(f)processCSV(f);}
function uploadCSV(input){if(input.files[0])processCSV(input.files[0]);}
async function processCSV(file){
  const s=document.getElementById('import-status');
  s.textContent='⏳ جاري الرفع...';
  const fd=new FormData();fd.append('file',file);
  const r=await fetch('/api/admin/questions/import-csv',{method:'POST',body:fd});
  const d=await r.json();
  if(d.ok){s.textContent='✅ تم استيراد '+d.inserted+' سؤال';s.style.color='#4ade80';toast('✅ استُورد '+d.inserted+' سؤال');loadQuestions();}
  else{s.textContent='❌ خطأ: '+(d.error||'مجهول');s.style.color='#f87171';}
}

// MISSIONS
async function loadMissions(){
  const d=await API('/api/admin/missions');
  const tb=document.querySelector('#tbl-missions tbody');
  tb.innerHTML='';
  (d.missions||[]).forEach(m=>{
    tb.innerHTML+=`<tr><td style="color:#64748b">${m.id}</td><td><b>${m.title}</b><br><small style="color:#64748b">${m.description||''}</small></td><td><span class="bg bg-b">${m.mission_type}</span></td><td><span class="bg bg-p">+${m.xp_reward}XP</span></td><td>${m.target_date||'<span style="color:#64748b">يومياً</span>'}</td><td><span class="bg ${m.is_active?'bg-g':'bg-y'}">${m.is_active?'نشطة':'موقوفة'}</span></td><td><button class="btn btn-d btn-sm" onclick="delMission(${m.id})">🗑️</button></td></tr>`;
  });
}
async function saveMission(){
  const t=document.getElementById('ms-title').value.trim();if(!t){toast('العنوان مطلوب','error');return;}
  const r=await API('/api/admin/missions','POST',{title:t,description:document.getElementById('ms-desc').value.trim(),mission_type:document.getElementById('ms-type').value,xp_reward:parseInt(document.getElementById('ms-xp').value)||20,target_date:document.getElementById('ms-date').value||null});
  if(r.ok){toast('✅ تمت الإضافة');closeModal('m-mission');loadMissions();}else toast(r.error||'خطأ','error');
}
async function delMission(id){if(!confirm('حذف؟'))return;const r=await API('/api/admin/missions/'+id,'DELETE');if(r.ok){toast('🗑️');loadMissions();}else toast('خطأ','error');}

// GRADING
async function loadGrading(){
  const d=await API('/api/admin/grading-rules');
  const tb=document.querySelector('#tbl-grading tbody');
  tb.innerHTML='';
  (d.rules||[]).forEach(r=>{
    tb.innerHTML+=`<tr><td style="color:#64748b">${r.id}</td><td><b>${r.topic}</b></td><td><span class="bg bg-b">${r.skill}</span></td><td>${r.vocab_points}</td><td>${r.connector_points}</td><td>${r.max_score}</td><td><button class="btn btn-d btn-sm" onclick="delGrading(${r.id})">🗑️</button></td></tr>`;
  });
}
async function saveGrading(){
  const t=document.getElementById('gr-topic').value.trim();if(!t){toast('الموضوع مطلوب','error');return;}
  const pk=id=>document.getElementById(id).value.split(',').map(s=>s.trim()).filter(Boolean);
  const r=await API('/api/admin/grading-rules','POST',{topic:t,skill:document.getElementById('gr-skill').value,vocab_keywords:pk('gr-vocab'),connector_keywords:pk('gr-conn'),forbidden_words:pk('gr-forb'),vocab_points:parseFloat(document.getElementById('gr-vp').value)||2,connector_points:parseFloat(document.getElementById('gr-cp').value)||3,forbidden_penalty:parseFloat(document.getElementById('gr-fp').value)||1,max_score:parseFloat(document.getElementById('gr-max').value)||100});
  if(r.ok){toast('✅ تمت الإضافة');closeModal('m-grading');loadGrading();}else toast(r.error||'خطأ','error');
}
async function delGrading(id){if(!confirm('حذف؟'))return;const r=await API('/api/admin/grading-rules/'+id,'DELETE');if(r.ok){toast('🗑️');loadGrading();}else toast('خطأ','error');}

// PHASES
async function loadPhases(){
  const d=await API('/api/admin/phase-settings');
  const c=document.getElementById('phases-cont');
  c.innerHTML='';
  (d.phases||[]).forEach(p=>{
    c.innerHTML+=`<div class="card" style="margin-bottom:12px"><div class="ch"><span class="ct">المرحلة ${p.phase_number}: ${p.phase_name||''}</span><button class="btn btn-p btn-sm" onclick="savePhase(${p.phase_number})">💾</button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><div class="fg"><label class="fl">الحد الأدنى XP</label><input class="fc" id="ph-${p.phase_number}-xp" value="${p.min_xp||0}" type="number"/></div><div class="fg"><label class="fl">الحد الأدنى Streak</label><input class="fc" id="ph-${p.phase_number}-st" value="${p.min_streak||0}" type="number"/></div><div class="fg"><label class="fl">الحد الأدنى Quiz %</label><input class="fc" id="ph-${p.phase_number}-qz" value="${p.min_quiz_score||0}" type="number"/></div><div class="fg"><label class="fl">أيام الحضور</label><input class="fc" id="ph-${p.phase_number}-at" value="${p.min_attendance_days||0}" type="number"/></div></div></div>`;
  });
}
async function savePhase(n){
  const r=await API('/api/admin/phase-settings/'+n,'PUT',{min_xp:parseInt(document.getElementById('ph-'+n+'-xp').value)||0,min_streak:parseInt(document.getElementById('ph-'+n+'-st').value)||0,min_quiz_score:parseFloat(document.getElementById('ph-'+n+'-qz').value)||0,min_attendance_days:parseInt(document.getElementById('ph-'+n+'-at').value)||0});
  if(r.ok)toast('✅ تم حفظ المرحلة '+n);else toast('خطأ','error');
}

// GRADUATION
const GRAD_KEYS=[{k:'graduation_min_xp',l:'الحد الأدنى XP'},{k:'graduation_min_tasks',l:'عدد المهام'},{k:'graduation_min_streak',l:'الحد الأدنى Streak'},{k:'graduation_min_mock_score',l:'الحد الأدنى Mock Exam'},{k:'graduation_mock_bonus',l:'نقاط إضافية'}];
async function loadGraduation(){
  const d=await API('/api/admin/settings');
  const sv={};(d.settings||[]).forEach(s=>sv[s.key]=s.value);
  document.getElementById('grad-form').innerHTML=GRAD_KEYS.map(x=>`<div class="fg"><label class="fl">${x.l}</label><input class="fc" id="gk-${x.k}" type="number" value="${sv[x.k]||0}"/></div>`).join('');
}
async function saveGrad(){
  const p={};GRAD_KEYS.forEach(x=>{const el=document.getElementById('gk-'+x.k);if(el)p[x.k]=el.value;});
  const r=await API('/api/admin/settings','POST',p);if(r.ok)toast('✅ تم الحفظ');else toast('خطأ','error');
}
async function checkGrad(){
  const uid=document.getElementById('grad-uid').value.trim();if(!uid){toast('أدخل ID','error');return;}
  const d=await API('/api/user/graduation-status?user_id='+uid);
  const div=document.getElementById('grad-result');
  if(d.error){div.innerHTML='<span class="bg bg-r">'+d.error+'</span>';return;}
  div.innerHTML='<div class="card" style="border-color:'+(d.eligible?'#4ade80':'#f87171')+'">'+(d.checks||[]).map(c=>'<div style="padding:5px 0;border-bottom:1px solid #334155;font-size:13px;color:'+(c.passed?'#4ade80':'#f87171')+'">'+c.message+'</div>').join('')+ '<div style="margin-top:10px;font-weight:700;color:'+(d.eligible?'#4ade80':'#f87171')+'">'+( d.eligible?'✅ مؤهل للتخرج!':'❌ غير مؤهل بعد')+'</div></div>';
}

// PLANS
async function loadPlans(){
  const d=await API('/api/admin/plans');
  const c=document.getElementById('plans-cont');c.innerHTML='';
  if(!(d.plans||[]).length){c.innerHTML='<p style="color:#64748b;text-align:center;padding:40px">لا توجد باقات</p>';return;}
  d.plans.forEach(p=>{
    let f=[];try{f=JSON.parse(p.features||'[]');}catch(e){}
    c.innerHTML+=`<div style="background:#0f172a;border:${p.is_featured?'2px solid #f59e0b':'1px solid #334155'};border-radius:14px;padding:18px;position:relative">
      ${p.is_featured?'<div style="position:absolute;top:-11px;right:14px;background:#f59e0b;color:#000;padding:2px 10px;border-radius:99px;font-size:10px;font-weight:700">موصى بها</div>':''} 
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px"><div><div style="font-size:15px;font-weight:700;color:#f1f5f9">${p.name_ar}</div><div style="font-size:11px;color:#64748b">${p.name}</div></div><span class="bg ${p.is_active?'bg-g':'bg-r'}">${p.is_active?'نشطة':'موقوفة'}</span></div>
      <div style="font-size:24px;font-weight:800;color:#6366f1">${Number(p.price).toLocaleString()} <span style="font-size:12px;color:#64748b">د.ع</span></div>
      <div style="font-size:12px;color:#64748b;margin-bottom:10px">${p.duration_days} يوم</div>
      ${f.map(x=>'<div style="font-size:12px;color:#94a3b8;padding:2px 0">✓ '+x+'</div>').join('')}
      <div style="display:flex;gap:6px;margin-top:12px;flex-wrap:wrap">
        <button class="btn btn-gh btn-sm" onclick="editPlan(${p.id})">✏️ تعديل</button>
        <button class="btn btn-sm" style="background:${p.is_active?'#7f1d1d':'#166534'};color:${p.is_active?'#f87171':'#4ade80'}" onclick="togglePlan(${p.id})">${p.is_active?'⏸':'▶'}</button>
        <button class="btn btn-d btn-sm" onclick="delPlan(${p.id})">🗑️</button>
      </div></div>`;
  });
}
function openPlanModal(r){
  if(r!==false){document.getElementById('m-plan-t').textContent='➕ باقة جديدة';document.getElementById('pl-id').value='';['pl-name','pl-name-ar','pl-price','pl-desc','pl-feats'].forEach(id=>document.getElementById(id).value='');document.getElementById('pl-days').value='30';document.getElementById('pl-active').checked=true;document.getElementById('pl-feat').checked=false;}
  openModal('m-plan');
}
async function editPlan(id){const d=await API('/api/admin/plans');const p=(d.plans||[]).find(x=>x.id===id);if(!p)return;document.getElementById('m-plan-t').textContent='✏️ تعديل الباقة';document.getElementById('pl-id').value=id;document.getElementById('pl-name').value=p.name||'';;document.getElementById('pl-name-ar').value=p.name_ar||'';;document.getElementById('pl-price').value=p.price||'';;document.getElementById('pl-days').value=p.duration_days||30;document.getElementById('pl-desc').value=p.description||'';;let f=[];try{f=JSON.parse(p.features||'[]');}catch(e){}document.getElementById('pl-feats').value=f.join('\n');document.getElementById('pl-active').checked=!!p.is_active;document.getElementById('pl-feat').checked=!!p.is_featured;openPlanModal(false);}
async function savePlan(){
  const n=document.getElementById('pl-name').value.trim();const na=document.getElementById('pl-name-ar').value.trim();const pr=document.getElementById('pl-price').value;
  if(!n||!na||!pr){toast('يرجى تعبئة الاسم والسعر','error');return;}
  const f=document.getElementById('pl-feats').value.split('\n').map(s=>s.trim()).filter(Boolean);
  const id=document.getElementById('pl-id').value;
  const r=await API(id?'/api/admin/plans/'+id:'/api/admin/plans',id?'PUT':'POST',{name:n,name_ar:na,price:parseFloat(pr)||0,currency:'IQD',duration_days:parseInt(document.getElementById('pl-days').value)||30,description:document.getElementById('pl-desc').value.trim(),features:f,is_active:document.getElementById('pl-active').checked?1:0,is_featured:document.getElementById('pl-feat').checked?1:0});
  if(r.ok){toast(id?'✅ تم التحديث':'✅ تمت الإضافة');closeModal('m-plan');loadPlans();}else toast(r.error||'خطأ','error');
}
async function togglePlan(id){const r=await API('/api/admin/plans/'+id+'/toggle','POST');if(r.ok){toast(r.is_active?'▶ تم التنشيط':'⏸ تم الإيقاف');loadPlans();}else toast('خطأ','error');}
async function delPlan(id){if(!confirm('حذف الباقة؟'))return;const r=await API('/api/admin/plans/'+id,'DELETE');if(r.ok){toast('🗑️');loadPlans();}else toast('خطأ','error');}

// PAYMENTS
async function loadPayments() {
  const d = await API('/api/admin/payments');
  const tb = document.querySelector('#tbl-payments tbody');
  if (!tb) return;
  tb.innerHTML = '';
  (d.payments || []).forEach(p => {
    const st = p.status || 'pending';
    const stClass = st==='approved'?'bg-success':st==='rejected'?'bg-danger':'bg-warning';
    const stAr = st==='approved'?'مفعّل':st==='rejected'?'مرفوض':'انتظار';
    const actions = st==='pending' ? `
      <button class="btn btn-g btn-sm" onclick="approvePayment(${p.id})">✅ موافقة</button>
      <button class="btn btn-d btn-sm" onclick="rejectPayment(${p.id})">❌ رفض</button>
    ` : `<span class="bg ${stClass}">${stAr}</span>`;
    tb.innerHTML += `<tr>
      <td>${p.id}</td>
      <td>${p.full_name||p.user_id||p.telegram_id||'-'}</td>
      <td>${p.plan_name||p.plan_id||'-'}</td>
      <td>${(p.amount||0).toLocaleString()} ${p.currency||'JOD'}</td>
      <td>${actions}</td>
      <td>${(p.created_at||'').slice(0,16)}</td>
    </tr>`;
  });
};
}
async function verifyPay(id){const r=await API('/api/admin/payments/'+id+'/verify','POST');if(r.ok){toast('✅ تم التحقق والتفعيل');loadPayments();}else toast('خطأ','error');}

// BROADCAST
function toggleBcTarget(){document.getElementById('bc-uid-wrap').style.display=document.getElementById('bc-target').value==='single'?'block':'none';}
async function sendBC(){
  const msg=document.getElementById('bc-msg').value.trim();const tgt=document.getElementById('bc-target').value;const uid=document.getElementById('bc-uid').value.trim();
  if(!msg){toast('اكتب رسالة','error');return;}if(tgt==='single'&&!uid){toast('أدخل ID','error');return;}
  document.getElementById('bc-status').textContent='⏳ جاري الإرسال...';
  const p={message:msg,target:tgt};if(tgt==='single')p.user_id=parseInt(uid);
  const r=await API('/api/admin/broadcast','POST',p);
  if(r.ok){toast('✅ أُرسلت لـ '+r.sent+' طالب');document.getElementById('bc-status').textContent='أُرسل: '+r.sent+' | فشل: '+r.failed;loadBCHistory();}else{toast(r.error||'خطأ','error');document.getElementById('bc-status').textContent='فشل';}
}
async function loadBCHistory(){
  const d=await API('/api/admin/broadcast/history');const tb=document.querySelector('#tbl-bc tbody');tb.innerHTML='';
  (d.history||[]).forEach(b=>{tb.innerHTML+=`<tr><td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${b.message}</td><td><span class="bg bg-b">${b.target==='all'?'الكل':'فردي'}</span></td><td>${b.sent_count||0}</td><td><span class="bg ${b.status==='sent'?'bg-g':'bg-y'}">${b.status}</span></td><td style="color:#64748b">${(b.created_at||'').slice(0,16)}</td></tr>`;});
}

// MESSAGES
async function loadMsgs(){
  const d=await API('/api/admin/messages');const c=document.getElementById('msgs-cont');
  const msgs=d.messages||[];const unread=msgs.filter(m=>!m.is_read).length;
  document.getElementById('nb-msgs').textContent=unread||0;
  if(!msgs.length){c.innerHTML='<p style="text-align:center;color:#64748b;padding:40px">لا توجد رسائل</p>';return;}
  c.innerHTML=msgs.map(m=>`<div style="padding:14px;border-bottom:1px solid #334155;background:${m.is_read?'transparent':'rgba(99,102,241,.05)'}"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px"><div><div style="font-weight:600;color:#f1f5f9">${m.full_name||m.username||'مجهول'}</div><div style="font-size:11px;color:#64748b">ID: ${m.user_id} • ${(m.created_at||'').slice(0,16)}</div></div><div style="display:flex;gap:6px">${!m.is_read?'<span class="bg bg-b">جديد</span>':''}<button class="btn btn-gh btn-sm" onclick="replyTo(${m.user_id})">↩️ رد</button>${!m.is_read?`<button class="btn btn-gh btn-sm" onclick="markRead(${m.id})">✓</button>`:''}</div></div><div style="background:#0f172a;padding:10px;border-radius:8px;font-size:13px;color:#cbd5e1">${m.message}</div></div>`).join('');
}
async function markRead(id){await API('/api/admin/messages/'+id+'/read','POST');loadMsgs();}
function replyTo(uid){document.getElementById('bc-target').value='single';document.getElementById('bc-uid').value=uid;document.getElementById('bc-uid-wrap').style.display='block';document.getElementById('bc-msg').value='';go('broadcast',document.querySelector('.nav[onclick*=broadcast]'));toast('اكتب ردك ثم اضغط إرسال');}

// SETTINGS
async function loadSettings(){
  const d=await API('/api/admin/settings');const f=document.getElementById('settings-form');f.innerHTML='';
  (d.settings||[]).forEach(s=>{const long=s.value&&s.value.length>40;f.innerHTML+=`<div class="fg" ${long?'style="grid-column:1/-1"':''} ><label class="fl">${s.description||s.key}</label>${long?`<textarea class="fc" id="st-${s.key}" rows="2">${s.value}</textarea>`:`<input class="fc" id="st-${s.key}" value="${s.value||''}"/>`}</div>`;});
}
async function saveSettings(){
  const d=await API('/api/admin/settings');const p={};
  (d.settings||[]).forEach(s=>{const el=document.getElementById('st-'+s.key);if(el)p[s.key]=el.value;});
  const r=await API('/api/admin/settings','POST',p);if(r.ok)toast('✅ تم حفظ الإعدادات');else toast('خطأ','error');
}

loadDash();
</script>

<!-- Modal: Add Student -->
<div id="modal-add-student" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center">
  <div style="background:#fff;border-radius:20px;padding:32px;width:100%;max-width:420px;margin:20px">
    <h3 style="margin-bottom:20px;font-size:18px;font-weight:800">➕ إضافة طالب جديد</h3>
    <input id="add-tid" type="number" placeholder="معرف تلغرام *" style="width:100%;padding:12px;border:2px solid #e2e8f0;border-radius:10px;margin-bottom:10px;font-family:Cairo,sans-serif;font-size:14px"/>
    <input id="add-name" type="text" placeholder="الاسم الكامل" style="width:100%;padding:12px;border:2px solid #e2e8f0;border-radius:10px;margin-bottom:10px;font-family:Cairo,sans-serif;font-size:14px"/>
    <input id="add-user" type="text" placeholder="يوزرنيم تلغرام" style="width:100%;padding:12px;border:2px solid #e2e8f0;border-radius:10px;margin-bottom:10px;font-family:Cairo,sans-serif;font-size:14px"/>
    <label style="display:flex;align-items:center;gap:8px;margin-bottom:20px;font-size:14px;cursor:pointer">
      <input type="checkbox" id="add-paid" style="width:18px;height:18px"/> تفعيل الاشتراك المدفوع فوراً
    </label>
    <div style="display:flex;gap:10px">
      <button onclick="submitAddStudent()" style="flex:1;padding:13px;background:linear-gradient(135deg,#4f7ef7,#818cf8);color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;font-family:Cairo,sans-serif">حفظ</button>
      <button onclick="document.getElementById('modal-add-student').style.display='none'" style="flex:1;padding:13px;background:#f1f5f9;color:#475569;border:none;border-radius:10px;font-size:15px;cursor:pointer;font-family:Cairo,sans-serif">إلغاء</button>
    </div>
  </div>
</div>
<script>
function openAddStudent(){
  document.getElementById('modal-add-student').style.display='flex';
}
async function submitAddStudent(){
  const tid  = document.getElementById('add-tid').value.trim();
  const name = document.getElementById('add-name').value.trim();
  const user = document.getElementById('add-user').value.trim();
  const paid = document.getElementById('add-paid').checked ? 1 : 0;
  if(!tid){ alert('معرف تلغرام مطلوب'); return; }
  const r = await fetch('/api/admin/students/add',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({telegram_id:parseInt(tid), full_name:name, username:user, is_paid:paid})
  });
  const d = await r.json();
  if(d.ok){
    document.getElementById('modal-add-student').style.display='none';
    showToast('✅ تم إضافة الطالب');
    loadStudents();
  } else {
    alert('خطأ: '+(d.error||'unknown'));
  }
}
</script>

<!-- Modal إضافة طالب -->
<div class="modal-bg" id="modalAddStudent">
  <div class="modal" style="max-width:420px">
    <div class="mh">
      <span style="font-weight:700;font-size:15px">&#x1F4CB; إضافة طالب يدوياً</span>
      <button onclick="document.getElementById('modalAddStudent').classList.remove('open')"
        style="background:none;border:none;color:#94a3b8;font-size:20px;cursor:pointer">&times;</button>
    </div>
    <div class="mb" style="display:flex;flex-direction:column;gap:12px">
      <div>
        <label style="font-size:12px;color:#94a3b8;display:block;margin-bottom:4px">Telegram ID *</label>
        <input class="fc" id="as_tid" type="number" placeholder="مثال: 5572314718">
      </div>
      <div>
        <label style="font-size:12px;color:#94a3b8;display:block;margin-bottom:4px">الاسم الكامل</label>
        <input class="fc" id="as_name" type="text" placeholder="اسم الطالب">
      </div>
      <div>
        <label style="font-size:12px;color:#94a3b8;display:block;margin-bottom:4px">يوزرنيم تيليجرام</label>
        <input class="fc" id="as_user" type="text" placeholder="@username (اختياري)">
      </div>
      <div style="display:flex;align-items:center;gap:8px">
        <input type="checkbox" id="as_paid" style="width:16px;height:16px">
        <label for="as_paid" style="font-size:13px;color:#cbd5e1">اشتراك مدفوع مفعّل</label>
      </div>
    </div>
    <div class="mf">
      <button class="btn btn-gh" onclick="document.getElementById('modalAddStudent').classList.remove('open')">إلغاء</button>
      <button class="btn btn-p" onclick="doAddStudent()">&#x2714; إضافة</button>
    </div>
  </div>
</div>

<script>
async function doAddStudent() {
  const tid  = document.getElementById('as_tid').value.trim();
  const name = document.getElementById('as_name').value.trim();
  const user = document.getElementById('as_user').value.trim();
  const paid = document.getElementById('as_paid').checked ? 1 : 0;
  if (!tid) { showToast('أدخل Telegram ID'); return; }
  try {
    const r = await fetch('/api/admin/students/add', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({telegram_id: parseInt(tid), full_name: name, username: user, is_paid: paid})
    });
    const d = await r.json();
    if (d.ok) {
      showToast('تم إضافة الطالب بنجاح');
      document.getElementById('modalAddStudent').classList.remove('open');
      document.getElementById('as_tid').value = '';
      document.getElementById('as_name').value = '';
      document.getElementById('as_user').value = '';
      document.getElementById('as_paid').checked = false;
      if (typeof loadStudents === 'function') loadStudents();
      else setTimeout(() => location.reload(), 1000);
    } else {
      showToast('خطأ: ' + (d.error || 'غير معروف'));
    }
  } catch(e) {
    showToast('خطأ في الاتصال');
  }
}
</script>


<script>
// ═══ Payment Actions ═══
async function approvePayment(pid) {
    if (!confirm('تأكيد الموافقة على الدفع وتفعيل الطالب؟')) return;
    const r = await fetch('/api/admin/payments/' + pid + '/approve', {method:'POST'});
    const d = await r.json();
    if (d.ok) { showToast('✅ تم تفعيل الطالب'); loadPayments(); loadStudents(); }
    else showToast('❌ ' + (d.error || 'خطأ'));
}

async function rejectPayment(pid) {
    if (!confirm('تأكيد رفض طلب الدفع؟')) return;
    const r = await fetch('/api/admin/payments/' + pid + '/reject', {method:'POST'});
    const d = await r.json();
    if (d.ok) { showToast('تم الرفض'); loadPayments(); }
    else showToast('❌ ' + (d.error || 'خطأ'));
}

// ═══ Student Actions ═══
async function deleteStudent(uid) {
    if (!confirm('حذف الطالب نهائياً؟ لا يمكن التراجع!')) return;
    const r = await fetch('/api/admin/students/' + uid + '/delete', {method:'DELETE'});
    const d = await r.json();
    if (d.ok) { showToast('تم الحذف'); loadStudents(); }
    else showToast('❌ ' + (d.error || 'خطأ'));
}

async function activateStudent(uid) {
    const r = await fetch('/api/admin/students/' + uid + '/activate-paid', {method:'POST'});
    const d = await r.json();
    if (d.ok) { showToast('✅ تم التفعيل'); loadStudents(); }
    else showToast('❌ ' + (d.error||'خطأ'));
}

async function deactivateStudent(uid) {
    const r = await fetch('/api/admin/students/' + uid + '/deactivate-paid', {method:'POST'});
    const d = await r.json();
    if (d.ok) { showToast('تم إلغاء التفعيل'); loadStudents(); }
    else showToast('❌ ' + (d.error||'خطأ'));
}

async function sendMsgToStudent(uid) {
    const txt = prompt('أدخل الرسالة للطالب:');
    if (!txt) return;
    const r = await fetch('/api/admin/students/' + uid + '/send-message', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({text: txt})
    });
    const d = await r.json();
    if (d.ok) showToast('✅ تم الإرسال');
    else showToast('❌ ' + (d.error||'خطأ'));
}
</script>

</body>
</html>
