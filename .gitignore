# Yamen Academy — gitignore

# Python
__pycache__/
*.pyc
*.pyo

# Secrets
.env
.env.*

# Backups (all variants)
*.bak
*.bak_*
*.backup
*.backup2
*.broken_*
*.before_*
*.old_backup
*.OLD
*.final_backup
_backups/
_archive/
_archive_*/
_SAFE_BACKUP*/

# Throwaway scripts at root
/_*.py
/_*.html
/_*.txt
/_*.md
/_scripts/
/notepad*

# Databases
*.db
*.db-shm
*.db-wal
academy_seeded_*.db
yamen_academy*.db

# Diagnostic outputs
diag*.txt
err*.txt
out*.txt
root_diag.txt
smoke_*_*.json
_tmp_*.py

# IDE
.vscode/
.idea/

# Force-keep (override the above)
!PROJECT_LOG.md
!README.md
!LAUNCH_README.md
!PROJECT_MAP.md